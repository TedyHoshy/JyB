// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Producto {
  id        Int      @id @default(autoincrement())
  nombre    String
  precio    Int
  stock     Int
  foto      String
  categoria String
  createdAt DateTime @default(now())
}

model Usuario {
  id        Int      @id @default(autoincrement())
  nombre    String
  correo    String   @unique
  clave     String
  rol       String   // "admin", "trabajador", "usuario"
  createdAt DateTime @default(now())
}

model Venta {
  id        Int         @id @default(autoincrement())
  total     Int
  usuarioId Int?
  createdAt DateTime    @default(now())
  items     VentaItem[]
}

model VentaItem {
  id         Int    @id @default(autoincrement())
  ventaId    Int
  productoId Int
  nombre     String
  precio     Int
  cantidad   Int
  subtotal   Int
  venta      Venta  @relation(fields: [ventaId], references: [id])
}
